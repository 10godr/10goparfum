# Copia este archivo como ".env" y ajusta tus datos de PostgreSQL.
# El archivo ".env" real NO se sube a git.
DATABASE_URL=postgresql+psycopg2://postgres:TU_PASSWORD@localhost:5432/diez_go_perfumes
# Tasa fija de demostración: cuántos pesos dominicanos (DOP) vale 1 USD
USD_TO_DOP=61

# Login del administrador (JWT). Cambia estos valores.
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-contrasena
# Clave para firmar los tokens: cualquier texto largo y aleatorio. Genera uno con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio
